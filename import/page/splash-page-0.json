          "name": "AppFeatures",
          "options": {
            "heading": "It Gets Better",
            "description": "Grounded in clinical research, our program fits seamlessly into your life, providing a personalized approach that adapts to your journey.",
            "features": [
              {
                "title": "Find Yourself Again",
                "description": "Mendara helps you break the cycle of stress and regain a sense of balance in your new role as a parent.",
                "icon": "AiOutlineCheckCircle",
                "image": "https://cdn.builder.io/api/v1/image/assets%2F4326c237495b421698d98079e65c9e17%2Fafff5d41a95a4e8cbadb3d6fb96b5910"
              },
              {
                "title": "Your Support Network",
                "description": "Connect with other parents who get it. Anonymity respected—find your community when it works for you.",
                "icon": "AiOutlineCheckCircle",
                "image": "https://cdn.builder.io/api/v1/image/assets%2F4326c237495b421698d98079e65c9e17%2F270aef5fd7534a0f88406b48d56b02ec"
              },
              {
                "title": "Rediscover Joy",
                "description": "Parenthood can be tough, but there’s hope. We’re here to help you find those small moments of joy again.",
                "icon": "AiOutlineCheckCircle",
                "image": "https://cdn.builder.io/api/v1/image/assets%2F4326c237495b421698d98079e65c9e17%2F75ab6fe243224e5caf8da627cf4273bc"
              },
              {
                "title": "Embrace your new life.",
                "description": "It’s about gaining more—more calm, more confidence, and meaningful moments with your child that make this new chapter fulfilling.",
                "icon": "AiOutlineCheckCircle",
                "image": "https://cdn.builder.io/api/v1/image/assets%2F4326c237495b421698d98079e65c9e17%2F9bf46d959e8945688de120cbc7b712fc"
