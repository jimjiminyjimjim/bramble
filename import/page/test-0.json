            "description": "",
            "screens": [
              {
                "title": "A Support Coach in Your Pocket",
                "description": "Mindy, your AI-powered recovery coach, will guide you through each step of the way, offering insights customized to your emotional and mental health needs.",
                "image": "https://cdn.builder.io/api/v1/image/assets%2F4326c237495b421698d98079e65c9e17%2Fd7d7eebf8451405da65692cd5749b77e"
              },
              {
                "title": "Personalised Support Through Every High and Low",
                "description": "Mendara provides tools designed to help you manage the fluctuating emotions that are often part of postnatal depression. Whether you’re feeling isolated at home or anxious about returning to work, Mendara’s short exercises give you the support you need—when you need it.",
                "image": "https://cdn.builder.io/api/v1/image/assets%2F4326c237495b421698d98079e65c9e17%2Fd7d7eebf8451405da65692cd5749b77e"
              },
              {
                "title": "Understand the Changes Your Mind and Body Are Undergoing",
                "description": "Learn about the neurological and hormonal changes that occur postpartum and how they influence your emotions. Mendara provides bite-sized, easily accessible insights to empower you with knowledge about what’s happening in your brain and body, helping you understand and manage the challenges of postnatal depression.",
                "image": "https://cdn.builder.io/api/v1/image/assets%2F4326c237495b421698d98079e65c9e17%2Fd7d7eebf8451405da65692cd5749b77e"
              },
              {
                "title": "Connect with a Compassionate Community of Parents",
                "description": "Join a safe, judgment-free space where other parents share their experiences with postnatal depression. Find comfort in knowing you’re not alone and engage in live events and support sessions designed to foster connection, growth, and resilience among parents who truly understand what you’re going through.",
                "image": "https://cdn.builder.io/api/v1/image/assets%2F4326c237495b421698d98079e65c9e17%2Fd7d7eebf8451405da65692cd5749b77e"
              }
            ],
            "theme": "light",
            "anchor": "How it works"
          }
        }
